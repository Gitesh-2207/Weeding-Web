# Environment Configuration Example
# Copy this file to .env or .env.local to customize local environment settings.

# Application Configuration
VITE_APP_TITLE="The Royal Wedding of Khushbu Patidar & Abhay Patidar"
VITE_SITE_URL="https://example.com"

# Google Maps Navigation & Embed URLs
VITE_GOOGLE_MAPS_EMBED_URL="https://maps.google.com/maps?q=Sundrel%2C+Madhya+Pradesh&t=&z=13&ie=UTF8&iwloc=&output=embed"
VITE_GOOGLE_MAPS_NAV_URL="https://www.google.com/maps/search/?api=1&query=Sundrel+Dhar+Madhya+Pradesh+India"

# Feature Flags
VITE_ENABLE_ANALYTICS=false
