# --- Environment Variables & Secrets ---
.env
.env.*
*.env
*.env.*
!.env.example
!.env.template

# --- Secret Keys, Certificates & Credentials ---
*.pem
*.key
*.cert
*.crt
*.cer
*.pfx
*.p12
*.pub
id_rsa*
id_ed25519*
secrets/
credentials.json
client_secret*.json
service-account*.json
firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist
auth_token*
token.json
oauth-key*.json
*.keystore
*.jks

# --- Dependencies ---
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- Production & Build Outputs ---
dist/
dist-ssr/
build/
out/
.cache/
.parcel-cache/
.turbo/

# --- Logs & Runtime Data ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Temporary, Cache & Backup Files ---
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*~
*.sw?
*.swo
*.swp

# --- Operating System Files ---
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump

# --- IDEs & Code Editors ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-project
*.sublime-workspace

# --- Testing & Coverage ---
coverage/
*.lcov
.nyc_output/
